{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Muslim Will design tokens",
  "version": "1.1.0",
  "recorded": "2026-09-20",
  "sources": {
    "colorAndType": "design-system.md (user-defined, canonical)",
    "structure": "components.md (Jomo on Mobbin, observed; colour and type substituted)"
  },
  "color": {
    "canonical": {
      "parchment": { "$value": "#F3EEE5", "$type": "color", "$description": "60%. Warm Parchment. Page backgrounds, breathing room, warm neutral surfaces." },
      "ink":       { "$value": "#172033", "$type": "color", "$description": "30%. Deep Ink. Typography, hierarchy, navigation, structural elements, toggles on, selected tab, selected chip toggle." },
      "burgundy":  { "$value": "#7A263A", "$type": "color", "$description": "10%. Burgundy. Primary pill or floating CTA, sheet confirm button, selected answer radio, legal milestone chips. Do not overuse." }
    },
    "derived": {
      "ink-muted":        { "$value": "#595E68", "$type": "color" },
      "ink-disabled":     { "$value": "#B1B0B0", "$type": "color" },
      "line":             { "$value": "#D9D5D0", "$type": "color" },
      "line-strong":      { "$value": "#BFBDBB", "$type": "color" },
      "surface-raised":   { "$value": "#FBF9F5", "$type": "color", "$description": "Cards, option rows, sheets, floating tab bar, secondary pill." },
      "surface-sunken":   { "$value": "#E8E4DC", "$type": "color", "$description": "Segmented track, search, tertiary pill, banners, neutral chips." },
      "burgundy-hover":   { "$value": "#6B2539", "$type": "color" },
      "burgundy-pressed": { "$value": "#612538", "$type": "color" },
      "burgundy-soft":    { "$value": "#E7DAD4", "$type": "color", "$description": "Milestone chip field, destructive action pill, disabled confirm button." },
      "on-burgundy":      { "$value": "#FBF9F5", "$type": "color" },
      "scrim":            { "$value": "rgba(23,32,51,0.35)", "$type": "color", "$description": "Dim behind a stacked sheet." }
    },
    "open": { "$description": "Success, warning and error hues are not defined; the system stays near-monochrome (toast = ink field, destructive = burgundy text on burgundy-soft). No dark theme." }
  },
  "font": {
    "family": {
      "display": { "$value": ["DM Serif Display", "Iowan Old Style", "Palatino Linotype", "Georgia", "serif"], "$type": "fontFamily", "$description": "Tab hero and one-question headline only." },
      "ui":      { "$value": ["Manrope", "Segoe UI", "Roboto", "Helvetica", "Arial", "sans-serif"], "$type": "fontFamily" },
      "arabic":  { "$value": ["Amiri", "Noto Naskh Arabic", "Traditional Arabic", "serif"], "$type": "fontFamily", "$description": "Proposal." }
    },
    "scale": {
      "hero":         { "family": "display", "size": 56, "lineHeight": 60, "weight": 400, "tabular": true, "use": "Tab screen hero number or word" },
      "display-l":    { "family": "display", "size": 30, "lineHeight": 36, "weight": 400, "tracking": "-0.01em", "use": "One-question headline" },
      "display-m":    { "family": "display", "size": 24, "lineHeight": 30, "weight": 400, "use": "Document title" },
      "screen-title": { "family": "ui", "size": 28, "lineHeight": 34, "weight": 700, "use": "Tab screen title" },
      "sheet-title":  { "family": "ui", "size": 17, "lineHeight": 22, "weight": 700, "use": "Sheet title, centred" },
      "section":      { "family": "ui", "size": 18, "lineHeight": 24, "weight": 700, "color": "ink-muted", "use": "Collapsible section header" },
      "card-title":   { "family": "ui", "size": 17, "lineHeight": 22, "weight": 700 },
      "row":          { "family": "ui", "size": 15, "lineHeight": 20, "weight": 500 },
      "row-sub":      { "family": "ui", "size": 13, "lineHeight": 18, "weight": 400, "color": "ink-muted" },
      "value":        { "family": "ui", "size": 15, "lineHeight": 20, "weight": 600, "color": "ink-muted", "tabular": true },
      "stat":         { "family": "ui", "size": 20, "lineHeight": 24, "weight": 700 },
      "stat-label":   { "family": "ui", "size": 13, "lineHeight": 18, "weight": 500, "color": "ink-muted" },
      "body":         { "family": "ui", "size": 15, "lineHeight": 22, "weight": 400 },
      "body-l":       { "family": "ui", "size": 17, "lineHeight": 26, "weight": 400 },
      "button":       { "family": "ui", "size": 16, "lineHeight": 20, "weight": 600 },
      "label":        { "family": "ui", "size": 13, "lineHeight": 18, "weight": 600, "tracking": "0.01em" },
      "chip":         { "family": "ui", "size": 12, "lineHeight": 16, "weight": 600 },
      "caption":      { "family": "ui", "size": 12, "lineHeight": 16, "weight": 400, "color": "ink-muted" },
      "overline":     { "family": "ui", "size": 11, "lineHeight": 16, "weight": 700, "tracking": "0.08em", "transform": "uppercase" }
    }
  },
  "space": {
    "screen-margin": 16, "card-padding": 16, "card-gap": 12, "section-gap": 24,
    "row-height": 52, "row-height-sub": 64, "button-height": 56, "control-height": 36,
    "icon-button": 40, "tab-bar-height": 64, "bottom-dock": 16
  },
  "radius": { "card": 16, "sheet": 32, "pill": 999, "input": 12, "thumb": 12 },
  "shadow": {
    "card":     "0 1px 2px rgba(23,32,51,.04)",
    "floating": "0 8px 24px rgba(23,32,51,.12)",
    "sheet":    "0 -8px 32px rgba(23,32,51,.12)"
  },
  "tone": ["Legal", "Calm", "Authoritative", "Human", "Precise", "Warm", "Contemporary"]
}
